import pandas as pd
from sklearn.cluster import KMeans, AgglomerativeClustering
from sklearn.metrics import silhouette_score

# ------------------------------------------------
# 1. Load Dataset
# ------------------------------------------------
df = pd.read_csv("goldprice.csv")

# ------------------------------------------------
# 2. Clean Numeric Columns (IMPORTANT)
# ------------------------------------------------
cols = ['Price', 'Open', 'High', 'Low']

for col in cols:
    df[col] = df[col].astype(str).str.replace(',', '')
    df[col] = pd.to_numeric(df[col])

df = df.dropna()

X = df[['Price', 'Open', 'High', 'Low']]

results = []

# ------------------------------------------------
# 3. K-Means Clustering
# ------------------------------------------------
kmeans = KMeans(n_clusters=3, random_state=42)
labels_kmeans = kmeans.fit_predict(X)

inertia = kmeans.inertia_
sil_score = silhouette_score(X, labels_kmeans)

results.append({
    "Model": "K-Means",
    "Inertia": inertia,
    "Silhouette": sil_score
})

# ------------------------------------------------
# 4. Hierarchical Clustering
# ------------------------------------------------
hier = AgglomerativeClustering(n_clusters=3)
labels_hier = hier.fit_predict(X)

sil_score = silhouette_score(X, labels_hier)

results.append({
    "Model": "Hierarchical",
    "Inertia": "N/A",
    "Silhouette": sil_score
})

# ------------------------------------------------
# 5. Results
# ------------------------------------------------
results_df = pd.DataFrame(results)

print("\nClustering Comparison:")
print(results_df.sort_values(by="Silhouette", ascending=False))

